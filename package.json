{
  "name": "passats",
  "version": "1.0.0",
  "description": "ATS CV Review \u2014 instant resume scoring",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:guides": "node scripts/build-guides.js",
    "build:logo": "node scripts/build-logo.js",
    "build:og": "node scripts/build-og-image.js",
    "dev": "node --watch server.js",
    "eval": "node scripts/eval-prompt.js",
    "owner:analyze": "bash scripts/owner-analyze.sh",
    "owner:ui": "bash scripts/owner-ui.sh",
    "quality:check": "node scripts/quality-benchmark.js",
    "quality:live": "node scripts/quality-benchmark.js --live",
    "runtime:check": "node scripts/runtime-config-check.js",
    "smoke:prod": "node scripts/smoke-test.js",
    "smoke:routes": "node scripts/smoke-routes.js",
    "start": "node server.js",
    "sync:csp": "node scripts/sync-csp-hashes.js",
    "sync:domain": "node scripts/sync-domain.js",
    "sync:faq": "node scripts/sync-structured-data.js",
    "sync:seo": "npm run build:guides && npm run sync:domain && npm run sync:faq && npm run sync:sitemap && npm run sync:csp",
    "sync:sitemap": "node scripts/build-sitemap.js",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "node --test test/browser.test.js",
    "test:node": "node --test test/unit.test.js test/e2e.test.js test/payment.test.js test/contract.test.js test/eval.test.js test/quality-benchmark.test.js test/domain.test.js test/injection.test.js test/hidden-text.test.js test/parse-preview.test.js test/devmode.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@napi-rs/canvas": "1.0.9",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "6.3.289",
    "posthog-node": "^5.52.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "supertest": "^7.2.2"
  }
}
