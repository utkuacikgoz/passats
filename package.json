{
  "name": "passats",
  "version": "1.0.0",
  "description": "ATS CV Review — instant resume scoring",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke:prod": "node scripts/smoke-test.js",
    "owner:analyze": "bash scripts/owner-analyze.sh",
    "owner:ui": "bash scripts/owner-ui.sh",
    "test": "node --test test/*.test.js",
    "quality:check": "node scripts/quality-benchmark.js",
    "quality:live": "node scripts/quality-benchmark.js --live",
    "runtime:check": "node scripts/runtime-config-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@napi-rs/canvas": "1.0.6",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "posthog-node": "^5.49.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
