ANTHROPIC_API_KEY=sk-ant-...
# Required: pin an exact Anthropic API model ID. Production has no fallback.
# Use a dated Anthropic model ID, not a moving alias (example shape only).
LLM_MODEL=claude-model-name-YYYYMMDD
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
JWT_SECRET=generate-a-random-64-char-hex-string
# Optional — previous JWT secret for graceful key rotation (set during rollover)
# JWT_SECRET_PREV=old-secret-here
PORT=3000
BASE_URL=http://localhost:3000

# Required — atomic one-analysis-per-payment enforcement and global rate limits
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Support mailbox shown in failure messages, the footer, and the legal pages.
# Must be a mailbox you actually read: it is the refund route, and a customer
# whose analysis fails has no other way to reach you.
SUPPORT_EMAIL=support@passats.com

# Optional — gates /api/health endpoint
HEALTH_SECRET=any-random-string

# Optional — enables /api/test-token for owner-only smoke tests in production
# TEST_SECRET=any-random-string
# TEST_ALLOWED_IPS=203.0.113.10

# Optional — server-side error tracing in PostHog
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Set to 'true' for local development (mocks payments + analysis)
# DEV_MODE=true
