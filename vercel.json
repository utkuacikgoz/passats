{
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(favicon\\.svg|favicon\\.ico|robots\\.txt|sitemap\\.xml|og-image\\.png|og-image\\.svg|llms\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
